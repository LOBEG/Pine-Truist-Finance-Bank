# =========================================================================
# Pine Bank — Environment Configuration (example)
# Copy to .env and fill values. DO NOT commit secrets.
# In Railway, set these as Service Variables.
# =========================================================================

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=core-banking-api
PORT=8080

# --- Database (Railway PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/pinebank
DATABASE_SSL=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --- Redis (Railway Redis) ---
REDIS_URL=redis://default:password@host:6379

# --- JWT (RS256) ---
# Generate with: openssl genrsa -out jwt_private.pem 2048; openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then base64-encode and paste here.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=pine-bank
JWT_AUDIENCE=pine-bank-clients
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Encryption (column-level AES-256-GCM key encryption key) ---
# 32 random bytes base64-encoded: openssl rand -base64 32
ENCRYPTION_KEK_B64=
# Pepper for refresh-token SHA-256 lookup hash: openssl rand -base64 32
REFRESH_TOKEN_PEPPER=

# --- CORS / Origins ---
CORS_ORIGINS=https://app.pinebank.com,https://admin.pinebank.com

# --- Email (Postmark transactional) ---
POSTMARK_TOKEN=
EMAIL_FROM="Pine Bank <no-reply@pinebank.com>"

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Object storage (S3 / Railway) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pine-bank-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# --- Internal service URLs (Railway private networking) ---
CORE_BANKING_URL=http://core-banking-api.railway.internal:8080
ADMIN_API_URL=http://admin-api.railway.internal:8080
REALTIME_GATEWAY_URL=http://realtime-gateway.railway.internal:8080

# --- Security ---
ADMIN_IP_ALLOWLIST=
RATE_LIMIT_TRUST_PROXY=true

# --- Bootstrap (first deploy) ---
BOOTSTRAP_ADMIN_EMAIL=admin@pinebank.com
BOOTSTRAP_ADMIN_PASSWORD=
RUN_HISTORICAL_SEED=false
