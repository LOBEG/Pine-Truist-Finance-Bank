# =========================================================================
# Pine Truist Finance Bank — Environment Configuration (example)
# Copy to .env and fill values. DO NOT commit secrets.
# In Railway, set these as Service Variables.
#
# NOTE: This application is Postgres-native. Redis is NOT required.
# All queues, pub/sub, rate limiting, and coordination use Postgres.
# =========================================================================

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=core-banking-api
PORT=8080
# Maximum combined HTTP request header size (bytes) accepted by the servers.
# Node defaults to 16384 (16 KB). Browsers with many accumulated cookies plus a
# large admin JWT can exceed that and get an HTTP 431 (Request Header Fields Too
# Large) — including on login. Raised to 64 KB by default; tune if needed.
MAX_HTTP_HEADER_SIZE_BYTES=65536

# --- Database (Railway PostgreSQL) ---
# The database handles: ledger, queues (pg-boss), pub/sub (LISTEN/NOTIFY),
# rate limiting, socket coordination, and all application state.
DATABASE_URL=postgres://user:password@host:5432/pinetruist
DATABASE_SSL=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
# Apply pending DB migrations automatically at service startup. Serialised
# across replicas with a Postgres advisory lock. When false (default), the
# service instead verifies the schema is ready and exits with a clear error if
# migrations have not been applied. Set to true if you are not running a
# separate pre-deploy migration step.
RUN_MIGRATIONS_ON_STARTUP=false

# --- JWT (RS256) ---
# Generate with: openssl genrsa -out jwt_private.pem 2048; openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then base64-encode and paste here.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=pine-truist-finance-bank
JWT_AUDIENCE=pine-truist-clients
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Encryption (column-level AES-256-GCM key encryption key) ---
# 32 random bytes base64-encoded: openssl rand -base64 32
ENCRYPTION_KEK_B64=
# Pepper for refresh-token SHA-256 lookup hash: openssl rand -base64 32
REFRESH_TOKEN_PEPPER=

# --- CORS / Origins ---
CORS_ORIGINS=https://app.pinetruistfinance.com,https://admin.pinetruistfinance.com

# --- Web Frontend ---
# Internal operations console base path (default: /ops). Keep this non-obvious
# and do NOT link from public pages. Access is verified by RBAC + MFA.
PINE_INTERNAL_BASE_PATH=/ops
# Public API base the SPA calls. Leave as /api/v1 to use the same-origin proxy
# below (recommended). Set to an absolute URL only if calling the API on a
# different origin (then the API must allow that origin via CORS_ORIGINS).
PINE_API_URL=/api/v1
# REQUIRED only for the SPLIT deployment (separate web service): upstream that
# the web preview server proxies /api/v1 to. Point at your api-gateway
# (recommended) or core-banking-api. On Railway private networking this is
# http://<service>.railway.internal:8080, e.g.:
#   PINE_BACKEND_URL=http://api-gateway.railway.internal:8080
# It must NOT point at the web service's own host (self-loop — fails fast).
# RECOMMENDED single-origin deployment (apps/api-gateway/Dockerfile.combined)
# serves the SPA from the api-gateway and needs NO PINE_BACKEND_URL at all.
# If unset it defaults to http://localhost:8080 (dev only); in a split
# production deploy an unset/unreachable value makes every /api/v1 call fail
# (HTTP 502 with the fix applied, or an opaque 500 on older builds).
PINE_BACKEND_URL=http://api-gateway.railway.internal:8080

# OPTIONAL (single-origin api-gateway): filesystem path to the built SPA. The
# gateway auto-detects apps/web/dist when present; override only if needed.
# WEB_STATIC_DIR=/app/apps/web/dist

# --- Email (Postmark transactional) ---
# Optional: If not configured, notification-worker runs in log-only mode.
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=no-reply@pinetruistfinance.com

# --- SMS (Twilio) ---
# Optional: If not configured, SMS notifications are logged only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Object storage (S3 / Railway) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pine-bank-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# --- Internal service URLs (Railway private networking) ---
CORE_BANKING_URL=http://core-banking-api.railway.internal:8080
ADMIN_API_URL=http://admin-api.railway.internal:8080
REALTIME_GATEWAY_URL=http://realtime-gateway.railway.internal:8080

# --- Security ---
ADMIN_IP_ALLOWLIST=
RATE_LIMIT_TRUST_PROXY=true

# --- Bootstrap (first deploy) ---
# WARNING: These credentials are used ONLY for one-time admin creation at startup.
# They are NEVER used for login authentication. Login always authenticates
# against the database password hash. After bootstrap, set ADMIN_BOOTSTRAP_ENABLED=false.
#
# IMPORTANT SECURITY NOTES:
# 1. ADMIN_PASSWORD can be any non-empty value of your choice. Use a strong
#    password in production — the length/complexity is no longer enforced.
# 2. After first deploy, set ADMIN_BOOTSTRAP_ENABLED=false or remove it
# 3. Admin login requires MFA enrollment on first login
# 4. Never commit real credentials - use Railway/CI secrets
ADMIN_BOOTSTRAP_ENABLED=false
# Username the admin signs in with (default: admin). 1–32 chars: letters,
# digits, dots, hyphens, underscores.
ADMIN_USERNAME=admin
# Optional. If omitted, a placeholder (<username>@admin.local) is derived so the
# admin can sign in with the username alone.
ADMIN_EMAIL=admin@pinetruistfinance.com
ADMIN_PASSWORD=
RUN_HISTORICAL_SEED=false

# --- External Rails (ACH/Wire) ---
# IMPORTANT: External ACH/wire transfers are DISABLED by default.
# The system operates in internal-ledger-only mode.
# To enable real money movement, you must:
# 1. Configure a regulated banking partner (Modern Treasury, Dwolla, etc.)
# 2. Update the external_rails_config table with enabled=true
# 3. Replace transaction-worker simulation with real provider adapters
# See docs/PRODUCTION_READINESS.md for the full go-live checklist.
